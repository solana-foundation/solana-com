{
  "name": "@workspace/ecosystem-data",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./wallet-taxonomy": {
      "import": "./src/wallets/taxonomy.ts"
    },
    "./wallets": {
      "import": "./src/wallets/index.ts"
    },
    "./wallets/metadata": "./src/wallets/metadata.ts"
  },
  "scripts": {
    "audit:data": "node ./scripts/audit-ecosystem-data.mjs",
    "wallets:research-queue": "node ./scripts/build-wallet-research-queue.mjs",
    "lint": "oxlint . --max-warnings 0 && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt .",
    "check-types": "tsc --noEmit",
    "clean": "node ../../scripts/clean.mjs ."
  },
  "devDependencies": {
    "@workspace/config-oxlint": "workspace:*",
    "@workspace/config-typescript": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "5.8.3"
  }
}
