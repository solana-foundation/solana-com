{
  "name": "@workspace/docs-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Build tooling for the developer docs content in apps/docs/content (rendered by apps/docs with Fumadocs).",
  "type": "module",
  "bin": {
    "docs-tooling": "./bin/docs-tooling.mjs"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "nav:verify": "tsx src/cli.ts nav verify",
    "examples:build": "tsx src/cli.ts examples",
    "gen:surfpool": "tsx src/generators/surfpool-rpc.ts",
    "gen:tags": "tsx src/generators/tags.ts",
    "gen:concepts": "tsx src/generators/concepts.ts",
    "gen:paths": "tsx src/generators/paths.ts",
    "gen:addresses": "tsx src/generators/addresses.ts",
    "generate": "pnpm run examples:build && pnpm run gen:surfpool && pnpm run gen:paths && pnpm run gen:concepts --sync && pnpm run gen:addresses --sync && pnpm run gen:tags",
    "generate:check": "pnpm run examples:build --check && pnpm run gen:surfpool --check && pnpm run gen:paths --check && pnpm run gen:concepts --check && pnpm run gen:addresses --check && pnpm run gen:tags --check",
    "verify": "tsx src/cli.ts verify",
    "diagrams:mermaid": "tsx scripts/render-mermaid.ts",
    "diagrams:themes": "node scripts/sync-diagram-themes.mjs",
    "diagrams:fonts": "python3 scripts/embed-diagram-fonts.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm run check-types",
    "check-types": "tsc --noEmit",
    "clean": "node ../../scripts/clean.mjs ."
  },
  "dependencies": {
    "@workspace/i18n": "workspace:*",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.22.4",
    "unified": "^11.0.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@workspace/config-typescript": "workspace:*",
    "playwright": "1.58.2",
    "typescript": "5.8.3",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
