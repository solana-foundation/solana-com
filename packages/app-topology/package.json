{
  "name": "@workspace/app-topology",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "check-generated": "node scripts/generate.ts --check",
    "lint": "pnpm exec eslint . --max-warnings 0 && pnpm -w exec prettier --ignore-path .prettierignore --check packages/app-topology",
    "lint:fix": "pnpm exec eslint --fix . && pnpm -w exec prettier --ignore-path .prettierignore --write packages/app-topology",
    "check-types": "tsc --noEmit",
    "test": "vitest run && pnpm run check-generated",
    "clean": "node ../../scripts/clean.mjs ."
  },
  "devDependencies": {
    "@workspace/config-eslint": "workspace:*",
    "@workspace/config-typescript": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "5.8.3",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.13.1"
}
