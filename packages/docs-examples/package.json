{
  "name": "@workspace/docs-examples",
  "version": "0.0.0",
  "private": true,
  "description": "Tested code examples for the docs. blocks.json files declare the slices shown on pages; packages/docs-tooling (examples:build) turns them and the recorded .output.txt files into apps/docs/content/snippets/examples. Exercised against a local Surfpool in CI.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm run check-types",
    "check-types": "tsc --noEmit",
    "clean": "node ../../scripts/clean.mjs ."
  },
  "dependencies": {
    "@metaplex-foundation/mpl-token-metadata-kit": "^0.0.3",
    "@solana-program/compute-budget": "^0.19.0",
    "@solana-program/memo": "^0.15.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana-program/token-2022": "^0.19.0",
    "@solana/keychain-memory": "^2.0.0",
    "@solana/kit": "^8.4.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-signer": "^0.19.0",
    "@solana/mosaic-sdk": "0.2.0",
    "@solana/spl-memo": "^0.2.5",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/surfpool": "^1.5.0",
    "@solana/surfpool-1.6": "npm:@solana/surfpool@1.6.0",
    "@solana/token-acl-gate-sdk": "^0.3.1",
    "@solana/token-acl-sdk": "^0.4.0",
    "@solana/web3.js-legacy": "npm:@solana/web3.js@1.99.0",
    "@solana/web3.js-v3": "npm:@solana/web3.js@^3.0.2",
    "@solana/zk-sdk": "^0.5.4",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "micro-ed25519-hdkey": "^0.1.2",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.15",
    "@types/node": "^24.13.3",
    "@workspace/config-typescript": "workspace:*",
    "tsx": "^4.22.4",
    "typescript": "5.8.3",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
