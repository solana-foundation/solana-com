{
  "name": "@solana-foundation/solana-com-sitemap",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "pnpm exec eslint . --max-warnings 0 && pnpm -w exec prettier --ignore-path .prettierignore --check packages/sitemap",
    "lint:fix": "pnpm exec eslint --fix . && pnpm -w exec prettier --ignore-path .prettierignore --write packages/sitemap",
    "check-types": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "clean": "node ../../scripts/clean.mjs ."
  },
  "dependencies": {
    "@workspace/ecosystem-data": "workspace:*",
    "@workspace/i18n": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@workspace/config-eslint": "workspace:*",
    "@workspace/config-typescript": "workspace:*",
    "typescript": "5.8.3",
    "vitest": "catalog:"
  }
}
