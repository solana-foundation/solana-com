{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/config-typescript/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "solana-com#build": {
      "dependsOn": ["^build"],
      "env": [
        "ANALYZE",
        "DATABRICKS_HTTP_PATH",
        "DATABRICKS_SERVER_HOSTNAME",
        "NEXT_PUBLIC_ACCELERATE_APP_URL",
        "NEXT_PUBLIC_BREAKPOINT_APP_URL",
        "NEXT_PUBLIC_DOCS_APP_URL",
        "NEXT_PUBLIC_INKEEP_API_KEY",
        "NEXT_PUBLIC_MEDIA_APP_URL",
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_RPC_ENDPOINT",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_TEMPLATES_APP_URL",
        "NEXT_PUBLIC_VERCEL_ENV",
        "NODE_ENV",
        "RPC_LATENCY_GRAFANA_BASE_URL",
        "RWA_XYZ_API_BASE_URL",
        "SIMPLECAST_PODCAST_ID",
        "SOLANA_RPC_URL",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_RELATED_PROJECTS",
        "VERCEL_URL",
        "YOUTUBE_CHANNEL_ID"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/config-typescript/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": [
        "CI",
        "DATABRICKS_TOKEN",
        "HELIUS_API_KEY",
        "INKEEP_API_KEY",
        "LUMA_PRIVATE_API_KEY",
        "RPC_LATENCY_GRAFANA_API_TOKEN",
        "RWA_XYZ_API_TOKEN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING",
        "SIMPLECAST_API_KEY",
        "YOUTUBE_API_KEY"
      ]
    },
    "solana-docs#build": {
      "dependsOn": ["^build"],
      "env": [
        "ANALYZE",
        "CODE_RUN_SERVER_URL",
        "NEXT_PUBLIC_INKEEP_API_KEY",
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_VERCEL_ENV",
        "NODE_ENV",
        "TXTX_SURFNET_URL",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_URL",
        "YOUTUBE_CHANNEL_ID"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/config-typescript/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": [
        "CI",
        "INKEEP_API_KEY",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING",
        "YOUTUBE_API_KEY"
      ]
    },
    "solana-com-media#build": {
      "dependsOn": ["^build"],
      "env": [
        "KEYSTATIC_GITHUB_CLIENT_ID",
        "NEXT_PUBLIC_INKEEP_API_KEY",
        "NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG",
        "NEXT_PUBLIC_KEYSTATIC_LOCAL",
        "NEXT_PUBLIC_MAIN_SITE_URL",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NODE_ENV",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_URL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/config-typescript/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": [
        "CI",
        "INKEEP_API_KEY",
        "KEYSTATIC_GITHUB_CLIENT_SECRET",
        "KEYSTATIC_SECRET",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING"
      ]
    },
    "solana-templates#build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_INKEEP_API_KEY",
        "NEXT_PUBLIC_MAIN_SITE_URL",
        "NODE_ENV"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/config-typescript/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "solana-com-accelerate#build": {
      "dependsOn": ["^build"],
      "env": [
        "AIRTABLE_BASE_ID_SPEAKERS",
        "AIRTABLE_TABLE_ID_MIAMI_AGENDA",
        "AIRTABLE_TABLE_ID_MIAMI_AGENDA_PUBLISHING_STATUS",
        "AIRTABLE_TABLE_ID_SPEAKERS",
        "AIRTABLE_VIEW_ID_MIAMI_AGENDA",
        "AIRTABLE_VIEW_ID_MIAMI_AGENDA_PUBLISHING_STATUS",
        "AIRTABLE_VIEW_ID_SPEAKERS",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NODE_ENV",
        "VERCEL_ENV",
        "VERCEL_URL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/config-typescript/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": [
        "AIRTABLE_PAT",
        "CI",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING"
      ]
    },
    "solana-com-breakpoint#build": {
      "dependsOn": ["^build"],
      "env": [
        "AIRTABLE_BASE_ID_AGENDA",
        "AIRTABLE_BASE_ID_SPEAKERS",
        "AIRTABLE_TABLE_ID_AGENDA",
        "AIRTABLE_TABLE_ID_SPEAKERS",
        "AIRTABLE_VIEW_ID_AGENDA",
        "AIRTABLE_VIEW_ID_SPEAKERS",
        "MEDIA_APP_URL",
        "NEXT_PUBLIC_MEDIA_APP_URL",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NODE_ENV",
        "VERCEL_ENV",
        "VERCEL_RELATED_PROJECTS",
        "VERCEL_URL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/config-typescript/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": [
        "AIRTABLE_PAT",
        "CI",
        "LUMA_PRIVATE_API_KEY",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.prettierignore",
        "$TURBO_ROOT$/.prettierrc*",
        "$TURBO_ROOT$/eslint.config.*",
        "$TURBO_ROOT$/packages/config-eslint/**",
        "$TURBO_ROOT$/packages/config-typescript/**"
      ],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "outputs": [],
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/config-typescript/**"
      ]
    },
    "test": {
      "dependsOn": ["^build", "^test"],
      "env": ["NODE_ENV"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/config-typescript/**"
      ],
      "passThroughEnv": ["CI"],
      "outputs": []
    },
    "solana-com#test": {
      "dependsOn": ["^build", "^test"],
      "env": [
        "NEXT_PUBLIC_ACCELERATE_APP_URL",
        "NEXT_PUBLIC_BREAKPOINT_APP_URL",
        "NEXT_PUBLIC_DOCS_APP_URL",
        "NEXT_PUBLIC_MEDIA_APP_URL",
        "NEXT_PUBLIC_TEMPLATES_APP_URL",
        "NODE_ENV",
        "VERCEL_RELATED_PROJECTS"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/config-typescript/**"
      ],
      "passThroughEnv": ["CI"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "passThroughEnv": ["*"],
      "persistent": true
    },
    "clean": {
      "cache": false,
      "outputs": []
    }
  }
}
