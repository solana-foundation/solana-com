  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "dev": "next dev --port 3003",
    "start": "next start",
    "i18n:lingo": "pnpm i18n:lingo:content",
    "i18n:lingo:content": "pnpm -w i18n:docs",
