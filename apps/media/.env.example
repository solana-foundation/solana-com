# === Development Mode ===
# Set to 'true' for local development (uses local filesystem instead of GitHub)
NEXT_PUBLIC_KEYSTATIC_LOCAL=true

# === Keystatic GitHub App ===
# These are auto-generated when you run the Keystatic setup flow:
# 1. Deploy with GitHub storage enabled (NEXT_PUBLIC_KEYSTATIC_LOCAL unset or false)
# 2. Visit /keystatic and click "Create GitHub App"
# 3. Keystatic generates these env vars automatically
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# === Vercel Blob ===
# Required for report PDF uploads when using the deployed CMS.
BLOB_READ_WRITE_TOKEN=

# === Cross-app navigation ===
# Set this to the main site URL so header/footer links navigate correctly
# Production: https://solana.com
# Preview: https://solana-com-git-[branch].vercel.app
# Local dev: http://localhost:3000
NEXT_PUBLIC_MAIN_SITE_URL=https://solana.com

# === Alpenglow metrics dashboard ===
# The dashboard queries Prometheus server-side. The exporter itself should be
# configured as a Prometheus scrape target (typically http://127.0.0.1:8080).
ALPENGLOW_PROMETHEUS_MAINNET_URL=
ALPENGLOW_PROMETHEUS_MAINNET_BEARER_TOKEN=
ALPENGLOW_PROMETHEUS_TESTNET_URL=http://127.0.0.1:9090
ALPENGLOW_PROMETHEUS_TESTNET_BEARER_TOKEN=
ALPENGLOW_PROMETHEUS_DEVNET_URL=
ALPENGLOW_PROMETHEUS_DEVNET_BEARER_TOKEN=

# Optional cluster-specific RPC endpoints for canonical activation status.
# Include the provider API key in the URL. Public cluster endpoints are used
# when these values are empty.
ALPENGLOW_RPC_MAINNET_URL=
ALPENGLOW_RPC_TESTNET_URL=
ALPENGLOW_RPC_DEVNET_URL=

## Inkeep Analytics to collect feedback on docs
INKEEP_API_KEY=
## Inkeep widget (client-side)
NEXT_PUBLIC_INKEEP_API_KEY=
