# YouTube
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=
# Simplecast
SIMPLECAST_PODCAST_ID=
SIMPLECAST_API_KEY=
# LUMA
LUMA_PRIVATE_API_KEY=
# RPC Endpoint
NEXT_PUBLIC_RPC_ENDPOINT=
## Inkeep Analytics to collect feedback on docs
INKEEP_API_KEY=
## Inkeep widget (client-side)
NEXT_PUBLIC_INKEEP_API_KEY=
# Posthog
NEXT_PUBLIC_POSTHOG_KEY=
# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1
# Media app URL
NEXT_PUBLIC_MEDIA_APP_URL=
# Breakpoint app URL
NEXT_PUBLIC_BREAKPOINT_APP_URL=

# Data API metrics route (data.solana.com) -- base URL includes the API
# Gateway's /v1 stage; the custom domain does not strip it.
DATA_API_URL=https://data.solana.com/v1
DATA_API_KEY=

# RPC latency Grafana Cloud Prometheus data route
RPC_LATENCY_GRAFANA_BASE_URL=https://rpclatency.grafana.net/api/datasources/proxy/uid/grafanacloud-prom
RPC_LATENCY_GRAFANA_API_TOKEN=

# RWA.xyz API
RWA_XYZ_API_TOKEN=

# Full RPC endpoint; any provider is supported.
SOLANA_RPC_URL=

# University Ambassador application (empty sheets initialize response headers on first submission)
# Configure the Vercel Firewall rate-limit ID `university-ambassador-submit` in the project dashboard.
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=
UNIVERSITY_AMBASSADOR_GOOGLE_SHEET_ID=
UNIVERSITY_AMBASSADOR_GOOGLE_SHEET_RANGE=
