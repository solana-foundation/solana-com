# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1
## Server to run docs code snippets
CODE_RUN_SERVER_URL=
## Surfnet URL to replace localhost url in docs code snippets
TXTX_SURFNET_URL=
# Media app URL
NEXT_PUBLIC_MEDIA_APP_URL=
# Breakpoint app URL
NEXT_PUBLIC_BREAKPOINT_APP_URL=
