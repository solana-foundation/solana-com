  "network.average-fee-30d": {
    "unit": "usd",
    "definition": "Total transaction fees (base and priority, valued at each day's SOL price) divided by all non-vote transactions, successful and failed, over the last 30 complete days. Excludes Jito tips.",
    "period": { "kind": "trailing", "days": 30 },
    "source": {
      "name": "Solana Data",
      "url": "https://solana.com/data?tab=overview&days=30"
    },
    "owner": "Ecosystem Engineering",
    "live": {
      "provider": "data-api",
      "metrics": ["Fees"],
      "multiplyBy": "SOL Price",
      "divideBy": [
        "Non Vote Transaction Count (Success)",
        "Non Vote Transaction Count (Failed)"
      ],
      "rollup": "sum",
      "days": 30
    },
    "snapshot": { "value": 0.0048, "asOf": "2026-10-29" },
    "verifiedAt": "2026-10-30",
    "reviewBy": "2027-01-30"
  },
