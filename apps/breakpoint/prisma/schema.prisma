generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id            String              @id @default(uuid()) @db.Uuid
  browserUuid   String              @unique @db.VarChar(255)
  ipHash        String?             @db.VarChar(43)
  country       String?             @db.VarChar(2)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  nominations   Nomination[]
  attempts      NominationAttempt[]
  votes         Vote[]
  hereForPerson HereForPerson?

  @@index([country])
  @@index([ipHash])
  @@map("awards_users")
}

model Vote {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  category      String   @db.VarChar(100)
  twitterHandle String   @db.VarChar(16)
  submittedAt   DateTime @default(now()) @db.Timestamptz(6)
  ipHash        String?  @db.VarChar(43)
  country       String?  @db.VarChar(2)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([category, submittedAt])
  @@index([submittedAt])
  @@map("awards_votes")
}

model Nomination {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  category      String   @db.VarChar(100)
  // X usernames are up to 15 characters; nominations are stored with a leading @.
  twitterHandle String   @db.VarChar(16)
  submittedAt   DateTime @default(now()) @db.Timestamptz(6)
  ipHash        String?  @db.VarChar(43)
  country       String?  @db.VarChar(2)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([category])
  @@index([submittedAt])
  @@index([country])
  @@index([ipHash])
  @@map("awards_nominations")
}

model NominationAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  category      String   @db.VarChar(100)
  twitterHandle String   @db.VarChar(16)
  ipHash        String?  @db.VarChar(43)
  country       String?  @db.VarChar(2)
  action        String   @db.VarChar(20)
  submittedAt   DateTime @default(now()) @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([category, twitterHandle])
  @@index([ipHash])
  @@index([submittedAt])
  @@map("awards_nomination_attempts")
}

model HereForXSession {
  id        String   @id @default(uuid()) @db.Uuid
  xUserId   String   @db.VarChar(32)
  handle    String   @db.VarChar(16)
  expiresAt DateTime @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("here_for_x_sessions")
}

model HereForPerson {
  id          String       @id @default(uuid()) @db.Uuid
  handle      String       @unique @db.VarChar(16)
  xUserId     String?      @db.VarChar(32)
  claimedById String?      @unique @db.Uuid
  claimedBy   User?        @relation(fields: [claimedById], references: [id], onDelete: SetNull)
  hidden      Boolean      @default(false)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  claimedAt   DateTime?    @db.Timestamptz(6)
  ipHash      String?      @db.VarChar(43)
  country     String?      @db.VarChar(2)
  adds        HereForAdd[] @relation("HereForFrom")
  addedBy     HereForAdd[] @relation("HereForTo")

  @@map("here_for_people")
}

model HereForAdd {
  id        String        @id @default(uuid()) @db.Uuid
  fromId    String        @db.Uuid
  toId      String        @db.Uuid
  rank      Int
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  from      HereForPerson @relation("HereForFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        HereForPerson @relation("HereForTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, rank])
  @@unique([fromId, toId])
  @@index([toId])
  @@map("here_for_adds")
}

model HereForLayoutSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  nodeCount Int
  linkCount Int
  payload   Json

  @@map("here_for_layout_snapshots")
}

/// Known X accounts for "Add your 3" typeahead, seeded offline so searching
/// never calls X. Not people on the map: those live in HereForPerson.
model HereForDirectoryEntry {
  handle    String   @id @db.VarChar(16)
  xUserId   String?  @unique @db.VarChar(32)
  name      String   @db.VarChar(64)
  followers Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("here_for_directory")
}
