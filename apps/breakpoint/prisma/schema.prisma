generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  browserUuid String       @unique @db.VarChar(255)
  ipHash      String?      @db.VarChar(43)
  country     String?      @db.VarChar(2)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  nominations Nomination[]
  attempts    NominationAttempt[]

  @@index([country])
  @@index([ipHash])
  @@map("awards_users")
}

model Nomination {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  category      String   @db.VarChar(100)
  twitterHandle String   @db.VarChar(15)
  submittedAt   DateTime @default(now()) @db.Timestamptz(6)
  ipHash        String?  @db.VarChar(43)
  country       String?  @db.VarChar(2)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([category])
  @@index([submittedAt])
  @@index([country])
  @@index([ipHash])
  @@map("awards_nominations")
}

model NominationAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  category      String   @db.VarChar(100)
  twitterHandle String   @db.VarChar(15)
  ipHash        String?  @db.VarChar(43)
  country       String?  @db.VarChar(2)
  action        String   @db.VarChar(20)
  submittedAt   DateTime @default(now()) @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([category, twitterHandle])
  @@index([ipHash])
  @@index([submittedAt])
  @@map("awards_nomination_attempts")
}
