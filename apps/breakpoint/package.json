{
  "name": "solana-com-breakpoint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose -f docker-compose.yml up -d --wait && pnpm prisma:deploy",
    "db:down": "docker compose -f docker-compose.yml down",
    "db:reset": "docker compose -f docker-compose.yml down -v && docker compose -f docker-compose.yml up -d --wait && pnpm prisma:deploy",
    "dev": "next dev --port 3005",
    "build": "node scripts/generate-prisma.mjs && node scripts/deploy-prisma.mjs && next build",
    "start": "next start",
    "lint": "pnpm exec eslint . && pnpm -w exec prettier --ignore-path .prettierignore --check apps/breakpoint",
    "lint:fix": "pnpm exec eslint --fix . && pnpm -w exec prettier --ignore-path .prettierignore --write apps/breakpoint",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "clean": "node ../../scripts/clean.mjs ."
  },
  "dependencies": {
    "@prisma/client": "6.18.0",
    "@sentry/nextjs": "^10.11.0",
    "@solana-com/ui-chrome": "workspace:*",
    "@solana-foundation/fab-menu": "workspace:*",
    "@vercel/firewall": "^1.2.5",
    "@vercel/related-projects": "^1.0.1",
    "@workspace/ecosystem-data": "workspace:*",
    "@workspace/i18n": "workspace:*",
    "@workspace/sentry": "workspace:*",
    "botid": "^1.5.11",
    "motion": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rtl-detect": "^1.1.2"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.14",
    "@types/react-dom": "^19.0.6",
    "@types/rtl-detect": "^1.0.3",
    "@workspace/config-eslint": "workspace:*",
    "@workspace/config-typescript": "workspace:*",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "prisma": "6.18.0",
    "tailwindcss": "^4.2.4",
    "typescript": "5.8.3",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.13.1"
}
