AIRTABLE_PAT=

AIRTABLE_BASE_ID_SPEAKERS=app_xxxxxxxxxxxxxx
AIRTABLE_TABLE_ID_SPEAKERS=tbl_xxxxxxxxxxxxxx
AIRTABLE_VIEW_ID_SPEAKERS=viw_xxxxxxxxxxxxxx

AIRTABLE_BASE_ID_AGENDA=app_xxxxxxxxxxxxxx
AIRTABLE_TABLE_ID_AGENDA=tbl_xxxxxxxxxxxxxx
AIRTABLE_VIEW_ID_AGENDA=viw_xxxxxxxxxxxxxx

# Optional: Luma API key for the highlighted events feed (public calendars work without it)
LUMA_PRIVATE_API_KEY=

# Community Awards PostgreSQL database. The local docker-compose instance is
# the default. Production access goes through an IAP tunnel; the GCP project,
# instance, zone and pgAdmin details live in the private runbook and Doppler,
# not in this file.
# POSTGRES_URL=postgresql://awards_app:<password>@127.0.0.1:5432/breakpoint_awards?sslmode=require
POSTGRES_URL=postgresql://breakpoint:breakpoint@localhost:54329/breakpoint_awards

# pgAdmin (through the same IAP tunnel; values in the private runbook).
PGADMIN_URL=
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Production-only secrets. Generate distinct 32+ character values for each.
AWARDS_COOKIE_SECRET=
AWARDS_IP_HASH_SECRET=

# X (Twitter) sign-in for Here For: "Sign in with X" via OAuth 2.0 with PKCE.
# It asks only for users.read and tweet.read (the minimum GET /2/users/me
# needs), reads the handle once, then revokes the token. Nothing is posted.
#
# Developer Console > your App > User authentication settings:
# - App permissions "Read", Type of App "Web App, Automated App or Bot",
#   Website URL https://solana.com/breakpoint, and these Callback URLs (X
#   matches them exactly):
#     http://localhost:3005/breakpoint/api/here-for/x/callback
#     https://solana.com/breakpoint/api/here-for/x/callback
# - Keys and tokens > OAuth 2.0 Client ID and Client Secret -> X_CLIENT_ID and
#   X_CLIENT_SECRET. A "Native App" client has no secret; leave it empty then.
# Production values live in Vercel env vars, never in this file.
X_CLIENT_ID=
X_CLIENT_SECRET=
# App-only bearer token. Sign-in doesn't use it; keep it for read-only API calls.
X_BEARER_TOKEN=
# Optional: overrides the callback URL, for example on a preview deployment
# whose URL you've also added to the App's Callback URLs.
X_OAUTH_CALLBACK_URL=
