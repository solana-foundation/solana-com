# Optional: Luma API key for the highlighted events feed (public calendars work without it)
LUMA_PRIVATE_API_KEY=

# Community Awards PostgreSQL database. For local access, first open an IAP
# tunnel: gcloud compute start-iap-tunnel postgres-01 5432 --local-host-port=localhost:5432 --zone=us-central1-a --project=breakpoint-26-awards-db
# POSTGRES_URL=postgresql://awards_app:<password>@127.0.0.1:5432/breakpoint_awards?sslmode=require
POSTGRES_URL=postgresql://breakpoint:breakpoint@localhost:54329/breakpoint_awards

# pgAdmin is available through an IAP tunnel:
# gcloud compute start-iap-tunnel postgres-01 80 --local-host-port=localhost:8080 --zone=us-central1-a --project=breakpoint-26-awards-db
PGADMIN_URL=http://127.0.0.1:8080/pgadmin4/
PGADMIN_EMAIL=admin@breakpoint-awards.internal
PGADMIN_PASSWORD=<password>

# Production-only secrets. Generate distinct 32+ character values for each.
AWARDS_COOKIE_SECRET=
AWARDS_IP_HASH_SECRET=

# X (Twitter) sign-in for Here For: "Sign in with X" via OAuth 1.0a
# three-legged auth. The access_token step returns the user's id and handle, so
# no scopes or extra API calls are needed, and nothing is posted for the user.
#
# Developer Console > your App:
# - Keys and tokens > Consumer Keys: API Key -> X_CONSUMER_KEY,
#   API Key Secret -> X_SECRET_KEY. Regenerate them there if they leak.
# - User authentication settings: App permissions "Read", Type of App
#   "Web App, Automated App or Bot", Website URL https://solana.com/breakpoint,
#   and these Callback URLs (X matches them exactly):
#     http://localhost:3005/breakpoint/api/here-for/x/callback
#     https://solana.com/breakpoint/api/here-for/x/callback
#   Without them, X rejects sign-in with "Desktop applications only support
#   the oauth_callback value 'oob'".
# Production values live in Vercel env vars, never in this file.
X_CONSUMER_KEY=
X_SECRET_KEY=
# App-only bearer token. Sign-in doesn't use it; keep it for read-only API calls.
X_BEARER_TOKEN=
# OAuth 2.0 Client ID and Secret, which X issues once User authentication
# settings are saved. Sign-in uses OAuth 1.0a and doesn't need them.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional: overrides the callback URL, for example on a preview deployment
# whose URL you've also added to the App's Callback URLs.
X_OAUTH_CALLBACK_URL=
