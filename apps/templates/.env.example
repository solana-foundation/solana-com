# Main Site URL Configuration
# This should be set to the base URL of the main solana.com site when deploying
# the templates app to a subdomain (templates.solana.com).
#
# - Production: https://solana.com
# - Preview/Staging: https://preview.solana.com (or your preview URL)
# - Local Development: http://localhost:3000 (if main site runs on 3000)
# - Leave empty or unset if this IS the main site
#
# This ensures header links navigate back to the main site from the subdomain.
NEXT_PUBLIC_MAIN_SITE_URL=https://solana.com

## Inkeep widget (client-side)
NEXT_PUBLIC_INKEEP_API_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1
# Web app origin, used to forward /api/ask/* to the docs search proxy when
# this app runs on its own origin (local dev, per-project preview).
# Leave unset behind solana.com, where the same-origin call already resolves.
NEXT_PUBLIC_WEB_APP_URL=
