# Code owners for solana-com (SDLC Appendix B, P1).
#
# Owners are auto-requested for review on matching paths. To make this a hard
# gate, enable "Require review from Code Owners" in branch protection for main.
# Settings that cannot be enforced from this repository are tracked in
# docs/security/admin-gaps.md.
#
# Last match wins, so the security-sensitive sections below override the
# global owners for those paths.

# Global owners — everything not matched by a more specific rule below.
*                               @h4rkl @jacobcreech

# --- Security-sensitive paths (Critical/Standard-tier changes) -------------

# CI/CD, automation, and repo policy. Changes here alter the security gates
# themselves, so they always need maintainer sign-off.
/.github/                       @h4rkl
/.github/workflows/             @h4rkl
/.github/CODEOWNERS             @h4rkl

# Secrets scanning and disclosure policy.
/.gitleaks.toml                 @h4rkl
/SECURITY.md                    @h4rkl

# Secrets rollout / Vercel deployment tooling.
/scripts/secrets-rollout/       @h4rkl

# Dependency surface — lockfile and workspace audit config (ignore lists).
/pnpm-lock.yaml                 @h4rkl
/pnpm-workspace.yaml            @h4rkl
/package.json                   @h4rkl

# Build orchestration, dependency patches, and the package-age policy.
/turbo.json                     @h4rkl
/.aikido                        @h4rkl
/patches/                       @h4rkl

# Scripts that run with repository credentials in CI.
/scripts/github/                @h4rkl
/scripts/guides-ci/             @h4rkl
/scripts/i18n/                  @h4rkl

# Per-app Vercel configuration (crons, related projects).
/apps/*/vercel.json             @h4rkl

# Editor MDX is compiled and executed server-side; review content as code.
/apps/media/content/            @h4rkl @jacobcreech

# Tested cookbook examples pull third-party packages readers will copy.
/packages/docs-examples/package.json  @h4rkl
