{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "semi": true,
  "printWidth": 80,
  "endOfLine": "lf",
  "proseWrap": "always",
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["**/*.mdx"],
      "options": {
        "trailingComma": "none"
      }
    },
    {
      "files": ["apps/media/**/*.mdx"],
      "options": {
        "printWidth": 100,
        "proseWrap": "preserve",
        "trailingComma": "none"
      }
    }
  ],
  "ignorePatterns": [
    ".github/*.md",
    "public",
    ".vercel",
    ".next",
    "**/.next",
    ".turbo",
    "dist",
    "coverage",
    "playwright-report",
    "apps/docs/.source",
    "apps/web/content/**/meta.json",
    ".claude",
    ".cursor",
    ".codex",
    ".gstack",
    ".secrets-migration",
    ".ralph",
    "RALPH_TASK.md",
    "turbo/generators/templates",
    "packages/i18n/messages/*/*",
    "!packages/i18n/messages/*/en",
    "apps/docs/content/docs/*",
    "!apps/docs/content/docs/en",
    "apps/docs/content/learn/*",
    "!apps/docs/content/learn/en",
    "apps/docs/content/developers-learn/*",
    "!apps/docs/content/developers-learn/en",
    "apps/media/content/posts/**/*.mdx",
    "apps/web/content/docs/*/rpc/**"
  ]
}
